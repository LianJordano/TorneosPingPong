# Copiá este archivo a .env y ajustá los valores. NUNCA subas el .env al repo.

APP_ENV=local
APP_DEBUG=true
APP_NAME="Torneos Ping Pong"
APP_BASE_URL=http://localhost:8000
APP_TZ=America/Bogota

# Base de datos (valores por defecto de Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pingpong
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
